<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header (Matching Image 3 Reference) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <ImageView
                android:id="@+id/btnMenuMore"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="6dp"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/text_white"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu" />
        </LinearLayout>

        <!-- Scrollable Body -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp">

                <!-- Ambient Glow Wrapper + Interactive Phone Mockup Frame -->
                <FrameLayout
                    android:id="@+id/containerMockupGlow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:padding="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp">

                    <!-- Ambient Glow Layer (animates when service is running) -->
                    <View
                        android:id="@+id/viewAmbientGlow"
                        android:layout_width="168dp"
                        android:layout_height="248dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_mockup_glow"
                        android:alpha="0" />

                    <!-- Phone Silhouette Card -->
                    <LinearLayout
                        android:id="@+id/cardPhoneMockup"
                        android:layout_width="156dp"
                        android:layout_height="236dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_card_dark"
                        android:gravity="top|center_horizontal"
                        android:paddingTop="32dp"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvMockupTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8:05"
                            android:textColor="#F0FFFFFF"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvMockupDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tue, Sep 1"
                            android:textColor="#85FFFFFF"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvMockupBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="81% • SAVING"
                            android:textColor="#65FFFFFF"
                            android:textSize="8.5sp"
                            android:letterSpacing="0.06" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="UNLOCK"
                            android:textColor="#65FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Sub-Navigation 3 Tabs (Look & Feel | Settings | Stats) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <!-- Tab 1: Look & Feel -->
                    <LinearLayout
                        android:id="@+id/tabBtnLookFeel"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvTabLookFeel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Look &amp; Feel"
                            android:textColor="@color/white_pure"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/indicatorLookFeel"
                            android:layout_width="32dp"
                            android:layout_height="2.5dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/white_pure" />
                    </LinearLayout>

                    <!-- Tab 2: Settings -->
                    <LinearLayout
                        android:id="@+id/tabBtnSettings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvTabSettings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Settings"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/indicatorSettings"
                            android:layout_width="32dp"
                            android:layout_height="2.5dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/white_pure"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <!-- Tab 3: Stats -->
                    <LinearLayout
                        android:id="@+id/tabBtnStats"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvTabStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stats"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/indicatorStats"
                            android:layout_width="32dp"
                            android:layout_height="2.5dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/white_pure"
                            android:visibility="invisible" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/card_dark_stroke"
                    android:layout_marginBottom="16dp" />

                <!-- ================= TAB CONTENT 1: LOOK & FEEL ================= -->
                <LinearLayout
                    android:id="@+id/contentLookFeel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Black Screen Mode"
                        android:textColor="@color/text_white"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- Mode Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="18dp">

                        <LinearLayout
                            android:id="@+id/cardModeFullScreen"
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_card_selected"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_blackout"
                                android:tint="@color/white_pure"
                                android:contentDescription="Full Screen" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Full Screen"
                                android:textColor="@color/white_pure"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardModePrivacy"
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_card_dark"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_shield"
                                android:tint="@color/text_muted"
                                android:contentDescription="Privacy Mode" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Privacy Mode"
                                android:textColor="@color/text_muted"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clock Style"
                        android:textColor="@color/text_white"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- 4 Clock Style Selection Cards Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <!-- Row 1: Style 1 (Modern) & Style 2 (Bold Mono) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <LinearLayout
                                android:id="@+id/cardStyleModern"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_card_selected"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="8:05"
                                    android:textColor="@color/white_pure"
                                    android:textSize="15sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Modern"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="9.5sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/cardStyleBold"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:layout_marginStart="5dp"
                                android:background="@drawable/bg_card_dark"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="08:05"
                                    android:textColor="@color/text_muted"
                                    android:textSize="15sp"
                                    android:fontFamily="monospace"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bold Mono"
                                    android:textColor="@color/text_muted"
                                    android:textSize="9.5sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row 2: Style 3 (Elegance Thin) & Style 4 (OLED Matrix) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/cardStyleThin"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_card_dark"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="8:05"
                                    android:textColor="@color/text_muted"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif-thin" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Elegance"
                                    android:textColor="@color/text_muted"
                                    android:textSize="9.5sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/cardStyleMatrix"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:layout_marginStart="5dp"
                                android:background="@drawable/bg_card_dark"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="8:05"
                                    android:textColor="@color/text_muted"
                                    android:textSize="15sp"
                                    android:fontFamily="sans-serif-condensed"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Matrix"
                                    android:textColor="@color/text_muted"
                                    android:textSize="9.5sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- ================= TAB CONTENT 2: SETTINGS ================= -->
                <LinearLayout
                    android:id="@+id/contentSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Setting 1: Show Clock -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Show Clock &amp; Battery"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchClock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/white_pure"
                            app:trackTint="@color/text_subtle" />
                    </LinearLayout>

                    <!-- Setting 2: 24-Hour Format -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="24-Hour Format"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch24Hour"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/white_pure"
                            app:trackTint="@color/text_subtle" />
                    </LinearLayout>

                    <!-- Setting 3: Show Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Show Date"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchShowDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/white_pure"
                            app:trackTint="@color/text_subtle" />
                    </LinearLayout>

                    <!-- Setting 4: Smart Pocket Mode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Smart Pocket Auto-Blackout"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchPocket"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/white_pure"
                            app:trackTint="@color/text_subtle" />
                    </LinearLayout>

                    <!-- Setting 5: Haptic Vibration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Haptic Vibration"
                            android:textColor="@color/text_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchVibration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbTint="@color/white_pure"
                            app:trackTint="@color/text_subtle" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ================= TAB CONTENT 3: STATS ================= -->
                <LinearLayout
                    android:id="@+id/contentStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Battery Saved Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTIMATED BATTERY SAVED"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tvStatsBatterySaved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="~0% Saved (0 mAh)"
                            android:textColor="@color/text_white"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Duration Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="horizontal"
                        android:padding="18dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TODAY'S BLACKOUT"
                                android:textColor="@color/text_secondary"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStatsTodayDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0s"
                                android:textColor="@color/text_white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="36dp"
                            android:background="@color/card_dark_stroke"
                            android:layout_marginHorizontal="16dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL BLACKOUT"
                                android:textColor="@color/text_secondary"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStatsTotalDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0s"
                                android:textColor="@color/text_white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Total Sessions Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL BLACKOUT SESSIONS"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStatsTotalSessions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 Sessions"
                            android:textColor="@color/text_white"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Android 13/14 Permission Helper (Shown only when needed) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OVERLAY PERMISSION REQUIRED"
                            android:textColor="@color/text_white"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGrantPermission"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="@color/white_pure"
                            android:text="GRANT OVERLAY PERMISSION"
                            android:textColor="@color/black_true"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenAppSettings"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="6dp"
                            android:backgroundTint="@color/card_dark_elevated"
                            android:text="UNBLOCK IN APP SETTINGS"
                            android:textColor="@color/white_pure"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- BOTTOM ACTION CONTROLLER (Matching Image 3 Bottom Placement) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black_true"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <!-- Big Start / Stop Button (Matching Image 3) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMasterBottomAction"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#FF6B00"
                android:text="Start"
                android:textColor="@color/white_pure"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:cornerRadius="27dp" />

            <!-- Direct Blacken Screen Trigger -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlackenScreenNow"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/card_dark_elevated"
                android:text="Blacken Screen Now"
                android:textColor="@color/white_pure"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:cornerRadius="21dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
