<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blackoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_true"
    android:keepScreenOn="true">

    <!-- Minimal Info & World Clock Display (Center) -->
    <LinearLayout
        android:id="@+id/layoutClockContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Exact Local / World Time -->
        <TextView
            android:id="@+id/tvClockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#88FFFFFF"
            android:textSize="64sp"
            android:fontFamily="sans-serif-thin"
            android:letterSpacing="0.04" />

        <!-- Day, Date and Month -->
        <TextView
            android:id="@+id/tvClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tuesday, 1 September"
            android:textColor="#55FFFFFF"
            android:textSize="14sp"
            android:letterSpacing="0.06" />

        <!-- Battery Status -->
        <TextView
            android:id="@+id/tvClockBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔋 85% • AMOLED SAVING"
            android:textColor="#40FFFFFF"
            android:textSize="11.5sp"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Tap-to-Reveal Bottom Unlock Pill (Auto-reveals on screen touch, fades out in 3.5s) -->
    <LinearLayout
        android:id="@+id/layoutUnlockPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="54dp"
        android:background="@drawable/bg_unlock_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:alpha="0">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_freeze"
            android:tint="@color/white_pure"
            android:contentDescription="Unlock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="TAP TO UNLOCK"
            android:textColor="@color/white_pure"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

</FrameLayout>
