<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blackoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_true"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:keepScreenOn="true">

    <!-- Top Positioned Typography (Time, Date, Battery) -->
    <LinearLayout
        android:id="@+id/layoutClockContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Time (e.g. 8:01) -->
        <TextView
            android:id="@+id/tvClockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8:01"
            android:textColor="#F5FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02" />

        <!-- Date (e.g. Tue, Sep 1) -->
        <TextView
            android:id="@+id/tvClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tue, Sep 1"
            android:textColor="#A0FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04" />

        <!-- Battery (e.g. 81% • SAVING) -->
        <TextView
            android:id="@+id/tvClockBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="81% • SAVING"
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <!-- Bottom UNLOCK Touch Area (Starts hidden with alpha=0, reveals on screen touch, 4s auto-fade) -->
    <LinearLayout
        android:id="@+id/layoutUnlockContainer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvUnlockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UNLOCK"
            android:textColor="#E0FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:alpha="0" />
    </LinearLayout>

</FrameLayout>
