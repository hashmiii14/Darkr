<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blackoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_true"
    android:keepScreenOn="true">

    <!-- Subtle Double Tap Wake Helper (Auto-fades out in 2.5 seconds) -->
    <LinearLayout
        android:id="@+id/layoutWakePrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#15FFFFFF"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:gravity="center">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_blackout"
            android:alpha="0.4"
            android:contentDescription="@string/mode_blackout_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/double_tap_to_wake"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.05" />
    </LinearLayout>

</FrameLayout>
