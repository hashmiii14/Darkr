<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Expandable Quick Action Bar (Hidden by default, shown on tap) -->
    <LinearLayout
        android:id="@+id/layoutQuickActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_dark"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_marginEnd="64dp"
        android:visibility="gone">

        <!-- Shield Button -->
        <ImageButton
            android:id="@+id/btnQuickShield"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_action_circle"
            android:src="@drawable/ic_shield"
            android:contentDescription="@string/action_shield" />

        <!-- Blackout Button -->
        <ImageButton
            android:id="@+id/btnQuickBlackout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_action_circle"
            android:src="@drawable/ic_blackout"
            android:contentDescription="@string/action_blackout" />

        <!-- Freeze Button -->
        <ImageButton
            android:id="@+id/btnQuickFreeze"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_action_circle"
            android:src="@drawable/ic_freeze"
            android:contentDescription="@string/action_freeze" />

        <!-- Dim Button -->
        <ImageButton
            android:id="@+id/btnQuickDim"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_action_circle"
            android:src="@drawable/ic_dimmer"
            android:contentDescription="@string/action_dim" />

        <!-- Close / Hide Pill Button -->
        <ImageButton
            android:id="@+id/btnQuickClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_action_circle"
            android:src="@drawable/ic_panic"
            android:contentDescription="@string/action_close" />
    </LinearLayout>

    <!-- Main Draggable Floating Ghost Pill Icon -->
    <FrameLayout
        android:id="@+id/pillContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_glowing_pill">

        <ImageView
            android:id="@+id/imgPillIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_darkr_logo"
            android:contentDescription="@string/title_floating_pill" />
    </FrameLayout>

</FrameLayout>
