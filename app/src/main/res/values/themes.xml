<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Darkr" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Pure Monochrome Theme -->
        <item name="colorPrimary">@color/white_pure</item>
        <item name="colorOnPrimary">@color/black_true</item>
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorOnSecondary">@color/black_true</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorOnSurface">@color/text_white</item>
        <item name="android:colorBackground">@color/black_true</item>

        <!-- System bar styling -->
        <item name="android:statusBarColor">@color/black_true</item>
        <item name="android:navigationBarColor">@color/black_true</item>
        <item name="android:windowBackground">@color/black_true</item>
    </style>

    <style name="Theme.Darkr.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
